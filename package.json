{
  "name": "praxis",
  "productName": "Praxis",
  "version": "0.0.1",
  "description": "AI design & prototyping tool \u2014 chat on the left, live preview of your repo on the right",
  "main": "./out/native/index.cjs",
  "license": "MIT",
  "bin": {
    "praxis": "bin/praxis.mjs"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "scripts": {
    "dev:native": "bun scripts/dev-native.mjs",
    "build:native": "bun scripts/build-native.mjs",
    "typecheck:native": "tsc --noEmit -p tsconfig.native.json",
    "test:native": "bun test/native-runtime.mjs",
    "test:native-live": "bun test/native-runtime-live.mjs",
    "link": "bun link",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:preview": "tsc --noEmit -p tsconfig.preview.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:preview",
    "test:prbody": "bun test/pr-body.mjs",
    "test:feedback-body": "bun test/feedback-body.mjs",
    "test:slash-token": "bun test/slash-token.mjs",
    "test:skills": "bun test/skills-discovery.mjs",
    "test:github-connect": "bun test/github-connect.mjs",
    "test:html-source": "bun test/html-source.mjs",
    "test:project-ui-jev": "bun test/project-ui-jev.mjs",
    "test:project-ui": "bun test/project-ui.mjs",
    "test:devnet": "bun test/devserver-net.mjs",
    "test:xcode": "bun test/xcode.mjs",
    "test:git": "bun test/git.mjs",
    "test:publish-reconcile": "bun test/publish-reconcile.mjs",
    "test:sidecar-migrate": "bun test/sidecar-migrate.mjs",
    "test:update": "bun test/update.mjs",
    "test:praxis-cli": "bun test/praxis-cli.mjs",
    "test:diag-cache": "bun test/diag-cache.mjs",
    "test:diag-rules": "bun test/diag-rules.mjs",
    "pilot:jev": "bun scripts/jev-pilot.mjs",
    "verify": "node test/run.mjs all",
    "test:projkey": "bun test/project-key.mjs",
    "test:sessionstore": "bun test/sessions-store.mjs",
    "test:preferred-model": "bun test/preferred-model.mjs",
    "test:project-memory": "bun test/project-memory.mjs",
    "test:project-icon": "bun test/project-icon.mjs",
    "test:providers": "bun test/providers-store.mjs",
    "test:model-catalog": "bun test/model-catalog.mjs",
    "test:codex-retry": "bun test/codex-retry-cause.mjs",
    "test:codex-stream": "bun test/codex-stream.mjs",
    "test:interrupt": "bun test/interrupt-escalation.mjs",
    "test:chat-title": "bun test/chat-title.mjs",
    "test:chat-settings": "bun test/chat-settings.mjs",
    "test:run-stats": "bun test/run-stats.mjs",
    "test:codex-usage": "bun test/codex-usage.mjs",
    "test:edithistory": "bun test/edit-history.mjs",
    "test:worktrees": "bun test/worktrees.mjs",
    "test:chat-worktrees": "bun test/chat-worktrees.mjs",
    "test:live-commit": "bun test/live-commit.mjs",
    "test:turn-terminal": "bun test/turn-terminal.mjs",
    "test:file-tree": "bun test/file-tree.mjs",
    "test:file-ops": "bun test/file-ops.mjs",
    "test:media-types": "bun test/media-types.mjs",
    "test:attachments": "bun test/attachments.mjs",
    "test:rules": "bun test/rules.mjs",
    "test:tw-classes": "bun test/tw-classes.mjs",
    "test:tw-styles": "bun test/tw-styles.mjs",
    "test:token-match": "bun test/token-match.mjs",
    "test:style-tokens": "bun test/style-tokens.mjs",
    "test:layers-move": "bun test/layers-move.mjs",
    "test:layers-labels": "bun test/layers-labels.mjs",
    "test:measure-distance": "bun test/measure-distance.mjs",
    "test:inline-style": "bun test/inline-style.mjs",
    "test:css-values": "bun test/css-values.mjs",
    "test:control-panels": "bun test/control-panels.mjs",
    "test:svelte-instance": "bun test/svelte-instance.mjs",
    "test:spring": "bun test/spring.mjs",
    "test:apca": "bun test/apca.mjs",
    "test:fluid": "bun test/fluid.mjs",
    "test:oklch": "bun test/oklch.mjs",
    "test:shadows": "bun test/shadows.mjs",
    "test:type-metrics": "bun test/type-metrics.mjs",
    "test:skills-install": "bun test/skills-install.mjs",
    "test:native-chat-controller": "bun test/native-chat-controller.mjs",
    "test:native-workspace": "bun test/native-workspace.mjs",
    "dev": "bun scripts/dev-native.mjs",
    "build": "bun scripts/build-native.mjs",
    "start": "bun out/native/index.cjs",
    "test": "node test/run.mjs unit native",
    "test:praxis-agent-tools": "bun test/praxis-agent-tools.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.186",
    "@babel/parser": "^8.0.0",
    "@json-render/codegen": "0.21.0",
    "@json-render/core": "0.21.0",
    "@openai/codex-sdk": "^0.154.0",
    "apca-w3": "^0.1.9",
    "colorparsley": "^0.1.8",
    "parse5": "^7.2.1",
    "react-docgen": "^8.0.3",
    "svelte": "^5.56.4",
    "zod": "^4.0.0",
    "@alikimovich/content-controls": "file:vendor/content-controls",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
